mainmenu "zbuddy"

DT_CHOSEN_BRIDGE_UART := zbuddy,bridge-uart

config ZBUDDY_APP_UART_BRIDGE
	bool "Speak the protocol over a UART as well (chosen zbuddy,bridge-uart)"
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_BRIDGE_UART))
	depends on $(dt_chosen_enabled,$(DT_CHOSEN_BRIDGE_UART))
	select SERIAL
	select UART_INTERRUPT_DRIVEN
	help
	  The desktop app only talks BLE, but the same newline-delimited JSON
	  on a UART lets tools/bridge_sim.py drive the device, and is the
	  bridge of the native_sim build.

config ZBUDDY_APP_BUILTIN_CHARACTER
	bool "Built-in character pack (the clawd crab) until one is pushed"
	default y
	help
	  app/src/builtin_pack.c, generated by tools/mkpack.py from
	  characters/clawd. A pack pushed from the desktop replaces it; the
	  "delete char" reset brings it back.

config ZBUDDY_APP_BRIDGE_DEBUG
	bool "Log every write and notification of the bridge"
	help
	  Shows what the desktop sends and what the device answers, byte
	  counts and the first bytes of each line. Chatty during a pack push.

config ZBUDDY_APP_MOUNT_POINT
	string "Mount point of the character storage"
	default "/lfs"

config ZBUDDY_APP_SCREEN_OFF_S
	int "Turn the screen off after this many idle seconds (0 = never)"
	default 0
	help
	  The original device runs on a battery and sleeps after 30 s; a USB
	  powered board keeps the pet (and the clock) visible.

config ZBUDDY_APP_TICK_MS
	int "Animation tick of the ASCII pets (ms)"
	default 200

config ZBUDDY_APP_BLE_PREFIX
	string "Advertised name prefix (the desktop looks for Claude*)"
	default "Claude"

config ZBUDDY_APP_LED
	bool "Blink the RGB LED while an approval is pending"
	default y
	depends on LED_STRIP

config ZBUDDY_APP_SOUND
	bool "Beep on prompts and buttons (buzzer0 alias)"
	default y
	depends on BUZZER

source "Kconfig.zephyr"
